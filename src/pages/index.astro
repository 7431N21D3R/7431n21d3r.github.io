---
import Base from '../layouts/Base.astro';
import { profile, certifications, resources, htb } from '../data/site.js';
import banner from '../data/banner.txt?raw';

const posts = Object.values(import.meta.glob('./posts/*.md', { eager: true }))
  .sort((a, b) => new Date(b.frontmatter.date) - new Date(a.frontmatter.date));
const fmt = (d) => new Date(d).toLocaleDateString('es-ES', { day: '2-digit', month: '2-digit', year: 'numeric' });
const featured = certifications.filter((c) => c.featured);
---
<Base>
  <section class="term" aria-label="Presentación">
    <div class="bar"><span>{profile.host}: ~</span></div>
    <div class="screen">
      <p class="cmd"><span class="p">{profile.host}</span>:~$ whoami</p>
      <pre class="banner" aria-label={profile.alias}>{banner.trimEnd()}</pre>
      <dl class="kv">
        <dt>nombre</dt><dd>{profile.name}</dd>
        <dt>rol</dt><dd>{profile.role}</dd>
        <dt>foco</dt><dd>Red Team, pentesting web e infraestructura, GRC (ENS, NIS2, DORA)</dd>
        <dt>base</dt><dd>{profile.location}</dd>
      </dl>
      <p class="cmd"><span class="p">{profile.host}</span>:~$ <span class="cursor" aria-hidden="true"></span></p>
    </div>
  </section>

  <section class="intro">
    <h1>Encontrar el fallo es la mitad del trabajo</h1>
    <p>Llevo más de siete años en seguridad ofensiva: pentesting de redes, aplicaciones web e infraestructura, y ejercicios de Red Team. Ahora también trabajo en GRC, donde intento que cada vulnerabilidad se traduzca en un riesgo que la organización entienda y corrija.</p>
    <p>Aquí publico write-ups de máquinas retiradas, recursos que uso en auditorías y notas sobre cómo encajan los hallazgos técnicos con el ENS, NIS2 o DORA.</p>
    <ul class="counts">
      <li><a href="/writeups/"><b>{posts.length}</b> write-ups</a></li>
      <li><a href="/recursos/"><b>{resources.length}</b> recursos</a></li>
      <li><a href="/certificaciones/"><b>{certifications.length}</b> certificaciones</a></li>
    </ul>
  </section>

  <div class="cols">
    <section>
      <h2>Últimos write-ups</h2>
      {posts.length === 0 ? <p class="lede">Todavía no hay write-ups publicados.</p> : (
        <ul class="list">
          {posts.slice(0, 5).map((p) => (
            <li><a href={p.url}>
              <span class="t">{p.frontmatter.title}</span>
              <span class="m">{p.frontmatter.os}, {p.frontmatter.difficulty}</span>
              <span class="d">{fmt(p.frontmatter.date)}</span>
            </a></li>
          ))}
        </ul>
      )}
      <p><a href="/writeups/">Ver todos los write-ups</a></p>
    </section>
    <section>
      <h2>Certificaciones</h2>
      <ul class="list">
        {featured.map((c) => (
          <li><a href="/certificaciones/">
            <span class="t">{c.name}</span>
            <span class="m">{c.issuer}</span>
            <span class="d">{c.full}</span>
          </a></li>
        ))}
      </ul>
      <p><a href="/certificaciones/">Ver las {certifications.length} certificaciones</a></p>
    </section>
  </div>

  <section class="htb">
    <h2>Hack The Box</h2>
    <div class="htb-card">
      <img src="https://htb-experience-prod-public-storage.s3.amazonaws.com/assets/ranks/svg/rank_master.svg" alt="" width="72" height="72" />
      <div>
        <p class="htb-rank"><a href={htb.url}>{htb.user}</a>, rango {htb.rank}, nivel {htb.level}</p>
        <p class="htb-stats">{htb.machines} máquinas, {htb.sherlocks} Sherlocks y {htb.challenges} retos resueltos. Datos de {htb.updated}.</p>
      </div>
    </div>
  </section>

  <section>
    <h2>Recursos</h2>
    <ul class="list">
      {resources.map((r) => (
        <li><a href={`https://github.com/7431N21D3R/${r.name}`}>
          <span class="t">{r.title}</span>
          <span class="m">GitHub</span>
          <span class="d">{r.text}</span>
        </a></li>
      ))}
    </ul>
  </section>
</Base>

<style>
  .term { border: 1px solid var(--line); border-radius: 6px; overflow: hidden; background: #0A1424; }
  .bar { padding: .45rem .9rem; background: var(--panel); border-bottom: 1px solid var(--line); font-family: var(--mono); font-size: .8rem; color: var(--muted); }
  .screen { padding: 1.25rem clamp(1rem, 3vw, 1.75rem) 1.5rem; font-family: var(--mono); font-size: .95rem; }
  .cmd { margin: 0 0 1rem; }
  .p { color: var(--signal); font-weight: 600; }
  .banner { font-family: 'DejaVu Sans Mono', Consolas, Menlo, monospace; margin: 0 0 1.25rem; padding: 0; border: 0; background: none; color: var(--amber); font-size: clamp(.38rem, 1.15vw, .78rem); line-height: 1; text-shadow: 0 0 12px rgba(242, 169, 59, .35); overflow-x: auto; overflow-y: hidden; }
  .kv { display: grid; grid-template-columns: max-content 1fr; gap: .2rem 1.25rem; margin: 0 0 1.25rem; }
  .kv dt { color: var(--muted); }
  .kv dd { margin: 0; }
  .cursor { display: inline-block; width: .6em; height: 1.1em; vertical-align: text-bottom; background: var(--amber); animation: blink 1.1s steps(1) infinite; }
  @keyframes blink { 50% { opacity: 0; } }
  .intro { margin-top: 3rem; max-width: 44rem; }
  .counts { list-style: none; padding: 0; margin: 1.5rem 0 0; display: flex; flex-wrap: wrap; gap: .75rem 2rem; }
  .counts a { color: var(--muted); text-decoration: none; }
  .counts b { font-family: var(--cond); font-size: 1.6rem; color: var(--paper); margin-right: .3rem; }
  .counts a:hover b { color: var(--amber); }
  .cols { display: grid; grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr)); gap: 0 3rem; }
  .htb-card { display: flex; align-items: center; gap: 1.25rem; padding: 1rem 0; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .htb-card p { margin: 0; }
  .htb-rank { font-family: var(--cond); font-weight: 700; font-size: 1.2rem; }
  .htb-stats { color: var(--muted); font-size: .95rem; }
</style>
